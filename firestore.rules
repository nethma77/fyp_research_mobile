rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can read and write their own driver profile
    match /drivers/{driverId} {
      allow read, write: if request.auth != null && request.auth.uid == driverId;
    }

    // Users can read and write vehicles in their own driver subcollection
    match /drivers/{driverId}/vehicles/{vehicleId} {
      allow read, write: if request.auth != null && request.auth.uid == driverId;
    }

    // Allow reading trips, parking, accidents, and violations for the authenticated user
    match /trips/{tripId} {
      allow read: if request.auth != null && resource.data.driverId == request.auth.uid;
      allow write: if request.auth != null && (request.auth.uid == resource.data.driverId || request.auth.uid == request.resource.data.driverId);
    }

    match /parking/{parkingId} {
      allow read, write: if request.auth != null;
    }

    match /accidents/{accidentId} {
      allow read: if request.auth != null && resource.data.driverId == request.auth.uid;
      allow write: if request.auth != null && (request.auth.uid == resource.data.driverId || request.auth.uid == request.resource.data.driverId);
    }

    match /violations/{violationId} {
      allow read: if request.auth != null && resource.data.driverId == request.auth.uid;
      allow write: if request.auth != null && (request.auth.uid == resource.data.driverId || request.auth.uid == request.resource.data.driverId);
    }
  }
}